// Spectral processing. A saw plays A2 and goes through Analyze into a Spectral
// Filter (a band pass from 300 Hz to 4 kHz), then a Spectral Shift of 40 Hz,
// which moves every partial up by the same number of hertz so the harmonic
// series falls apart into something bell-like, and back to audio through
// Synthesize. Analyze and Synthesize delay the sound by about 43 ms (2047
// samples); the engine delays the dry saw mixed in beside it by the same
// amount, so the two stay aligned.
(
    format: 1,
    graph: (
        nodes: {
            1: (type: "noodle.input.button", params: {"state": 1.0}, position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.event.key", params: {"note": 45.0, "velocity": 0.9}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.event.mono", position: (x: 400.0, y: 0.0)),
            4: (type: "noodle.osc.saw", position: (x: 600.0, y: 0.0)),
            5: (type: "noodle.spectral.analyze", position: (x: 800.0, y: 0.0)),
            6: (type: "noodle.spectral.filter", params: {"low": 300.0, "high": 4000.0}, position: (x: 1000.0, y: 0.0)),
            7: (type: "noodle.spectral.shift", params: {"shift": 40.0}, position: (x: 1200.0, y: 0.0)),
            8: (type: "noodle.spectral.synthesize", position: (x: 1400.0, y: 0.0)),
            9: (type: "noodle.util.mix", position: (x: 1600.0, y: 0.0)),
            10: (type: "noodle.util.gain", params: {"gain": -12.0}, position: (x: 800.0, y: 200.0)),
            11: (type: "noodle.util.gain", params: {"gain": -9.0}, position: (x: 1800.0, y: 0.0)),
            12: (type: "noodle.io.output", position: (x: 2000.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "out"), to: (node: 2, port: "gate")),
            (from: (node: 2, port: "out"), to: (node: 3, port: "in")),
            (from: (node: 3, port: "pitch"), to: (node: 4, port: "frequency")),
            (from: (node: 4, port: "out"), to: (node: 5, port: "in")),
            (from: (node: 5, port: "spectrum"), to: (node: 6, port: "spectrum")),
            (from: (node: 6, port: "out"), to: (node: 7, port: "spectrum")),
            (from: (node: 7, port: "out"), to: (node: 8, port: "spectrum")),
            (from: (node: 8, port: "out"), to: (node: 9, port: "in1")),
            (from: (node: 4, port: "out"), to: (node: 10, port: "in")),
            (from: (node: 10, port: "out"), to: (node: 9, port: "in2")),
            (from: (node: 9, port: "out"), to: (node: 11, port: "in")),
            (from: (node: 11, port: "out"), to: (node: 12, port: "in")),
        ],
    ),
)
