// A monophonic wavetable voice: a Key plays A2 while a Button is on, Mono Note
// turns its note events into pitch and gate, and the Wavetable oscillator
// plays them from a table of eight cycles that grow from a sine into a saw
// (a sample in `samples/`, cut every 2048 frames). A slow LFO sweeps its
// `position` through the cycles (the wire offsets it along its slider), and an
// ADSR shapes the note through a VCA.
(
    format: 4,
    graph: (
        nodes: {
            1: (type: "noodle.input.button", params: {"state": 1.0}, position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.event.key", params: {"note": 45.0, "velocity": 0.9}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.event.mono", position: (x: 400.0, y: 0.0)),
            4: (type: "noodle.osc.wavetable", config: {"table": "52d026860b60a6150d442442068f7b045dede70281c85e2ba72f90bede700979", "cycle": 2048}, params: {"position": 0.0}, position: (x: 600.0, y: -80.0)),
            5: (type: "noodle.mod.lfo", params: {"rate": 6.0, "depth": 0.5, "offset": 0.5}, position: (x: 400.0, y: -240.0)),
            6: (type: "noodle.mod.adsr", params: {"attack": 0.02, "decay": 0.1, "sustain": 0.7, "release": 0.3}, position: (x: 600.0, y: 100.0)),
            7: (type: "noodle.util.vca", position: (x: 800.0, y: 0.0)),
            8: (type: "noodle.util.gain", params: {"gain": -9.0}, position: (x: 1000.0, y: 0.0)),
            9: (type: "noodle.io.output", position: (x: 1200.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "out"), to: (node: 2, port: "gate")),
            (from: (node: 2, port: "out"), to: (node: 3, port: "in")),
            (from: (node: 3, port: "pitch"), to: (node: 4, port: "frequency")),
            (from: (node: 5, port: "out"), to: (node: 4, port: "position")),
            (from: (node: 3, port: "gate"), to: (node: 6, port: "gate")),
            (from: (node: 4, port: "out"), to: (node: 7, port: "in")),
            (from: (node: 6, port: "out"), to: (node: 7, port: "level")),
            (from: (node: 7, port: "out"), to: (node: 8, port: "in")),
            (from: (node: 8, port: "out"), to: (node: 9, port: "in")),
        ],
    ),
)
