// A polyphonic subtractive synth played from a MIDI clip. The track's MIDI
// goes to Voices (four voices), which feed a group, "Subtractive Voice". The
// synth is that group, built from ordinary nodes you can open and change: a
// unison saw, a ladder filter whose cutoff an envelope sweeps (scaled by a
// Math node), and an amplitude envelope through a VCA. Its controls (pitch,
// gate, cutoff, resonance, detune, spread) are the group's inputs. Voice Mix
// sums the voices. Released voices are skipped, and so is every voice that
// has not been played yet. The clip rolls an A minor 7th chord.
(
    format: 1,
    graph: (
        nodes: {
            1: (type: "noodle.track.input", position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.poly.voices", config: {"voices": 4}, params: {"tail": 2.0}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.group", config: {"name": "Subtractive Voice"}, position: (x: 450.0, y: 0.0)),
            4: (type: "noodle.poly.voice_mix", position: (x: 700.0, y: 0.0)),
            5: (type: "noodle.util.gain", params: {"gain": -14.0}, position: (x: 900.0, y: 0.0)),
            6: (type: "noodle.io.output", position: (x: 1100.0, y: 0.0)),
            // Inside the group: the controls are the group's inputs. Leave one
            // unwired and the node behind it keeps the value set here.
            10: (type: "noodle.group.input", config: {"name": "pitch"}, parent: Some(3), position: (x: -600.0, y: -100.0)),
            11: (type: "noodle.group.input", config: {"name": "gate"}, parent: Some(3), position: (x: -600.0, y: 100.0)),
            12: (type: "noodle.group.input", config: {"name": "cutoff"}, parent: Some(3), position: (x: -600.0, y: 300.0)),
            13: (type: "noodle.group.input", config: {"name": "resonance"}, parent: Some(3), position: (x: -600.0, y: 400.0)),
            14: (type: "noodle.group.input", config: {"name": "detune"}, parent: Some(3), position: (x: -600.0, y: -300.0)),
            15: (type: "noodle.group.input", config: {"name": "spread"}, parent: Some(3), position: (x: -600.0, y: -200.0)),
            16: (type: "noodle.osc.unison_saw", config: {"unison": 5}, params: {"detune": 18.0, "spread": 0.7}, parent: Some(3), position: (x: -300.0, y: -100.0)),
            17: (type: "noodle.filter.ladder", params: {"cutoff": 250.0, "resonance": 0.35}, parent: Some(3), position: (x: 0.0, y: 0.0)),
            18: (type: "noodle.mod.adsr", params: {"attack": 0.004, "decay": 0.25, "sustain": 0.2, "release": 0.2}, parent: Some(3), position: (x: -300.0, y: 200.0)),
            19: (type: "noodle.util.math", config: {"expr": "a * b + c"}, params: {"b": 0.55}, parent: Some(3), position: (x: -150.0, y: 200.0)),
            20: (type: "noodle.mod.adsr", params: {"attack": 0.01, "decay": 0.1, "sustain": 0.8, "release": 0.25}, parent: Some(3), position: (x: -300.0, y: 400.0)),
            21: (type: "noodle.util.vca", parent: Some(3), position: (x: 250.0, y: 0.0)),
            22: (type: "noodle.group.output", config: {"name": "out"}, parent: Some(3), position: (x: 500.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "midi"), to: (node: 2, port: "in")),
            (from: (node: 2, port: "pitch"), to: (node: 3, port: "pitch")),
            (from: (node: 2, port: "gate"), to: (node: 3, port: "gate")),
            (from: (node: 3, port: "out"), to: (node: 4, port: "in")),
            (from: (node: 4, port: "out"), to: (node: 5, port: "in")),
            (from: (node: 5, port: "out"), to: (node: 6, port: "in")),
            (from: (node: 10, port: "out"), to: (node: 16, port: "frequency")),
            (from: (node: 14, port: "out"), to: (node: 16, port: "detune")),
            (from: (node: 15, port: "out"), to: (node: 16, port: "spread")),
            (from: (node: 16, port: "out"), to: (node: 17, port: "in")),
            (from: (node: 11, port: "out"), to: (node: 18, port: "gate")),
            (from: (node: 11, port: "out"), to: (node: 20, port: "gate")),
            (from: (node: 18, port: "out"), to: (node: 19, port: "a")),
            (from: (node: 19, port: "out"), to: (node: 17, port: "cutoff")),
            (from: (node: 12, port: "out"), to: (node: 19, port: "c")),
            (from: (node: 13, port: "out"), to: (node: 17, port: "resonance")),
            (from: (node: 17, port: "out"), to: (node: 21, port: "in")),
            (from: (node: 20, port: "out"), to: (node: 21, port: "level")),
            (from: (node: 21, port: "out"), to: (node: 22, port: "in")),
        ],
    ),
    clips: {
        1: (
            node: 1,
            start: 0,
            content: Midi((
                length: 3840,
                notes: [
                    (start: 0, length: 1800, key: 45, velocity: 0.9),
                    (start: 30, length: 1800, key: 60, velocity: 0.8),
                    (start: 60, length: 1800, key: 64, velocity: 0.8),
                    (start: 90, length: 1800, key: 67, velocity: 0.8),
                ],
            )),
        ),
    },
)
