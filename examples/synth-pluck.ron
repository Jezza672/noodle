// A monophonic synth voice from events: a Key plays A3 while a Button is on,
// Mono Note turns its note events into pitch and gate, a saw runs through a
// low-pass filter whose cutoff an LFO sweeps (the wire offsets the cutoff
// along its slider), and an ADSR shapes the note through a VCA.
(
    format: 1,
    graph: (
        nodes: {
            1: (type: "noodle.input.button", params: {"state": 1.0}, position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.event.key", params: {"note": 57.0, "velocity": 0.9}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.event.mono", position: (x: 400.0, y: 0.0)),
            4: (type: "noodle.osc.saw", position: (x: 600.0, y: -80.0)),
            5: (type: "noodle.filter.svf", params: {"cutoff": 700.0, "resonance": 0.3}, position: (x: 800.0, y: -80.0)),
            6: (type: "noodle.mod.lfo", params: {"rate": 6.0, "depth": 0.08}, position: (x: 600.0, y: -240.0)),
            7: (type: "noodle.mod.adsr", params: {"attack": 0.02, "decay": 0.1, "sustain": 0.6, "release": 0.3}, position: (x: 600.0, y: 100.0)),
            8: (type: "noodle.util.vca", position: (x: 1000.0, y: 0.0)),
            9: (type: "noodle.util.gain", params: {"gain": -12.0}, position: (x: 1200.0, y: 0.0)),
            10: (type: "noodle.io.output", position: (x: 1400.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "out"), to: (node: 2, port: "gate")),
            (from: (node: 2, port: "out"), to: (node: 3, port: "in")),
            (from: (node: 3, port: "pitch"), to: (node: 4, port: "frequency")),
            (from: (node: 4, port: "out"), to: (node: 5, port: "in")),
            (from: (node: 6, port: "out"), to: (node: 5, port: "cutoff")),
            (from: (node: 3, port: "gate"), to: (node: 7, port: "gate")),
            (from: (node: 5, port: "low"), to: (node: 8, port: "in")),
            (from: (node: 7, port: "out"), to: (node: 8, port: "level")),
            (from: (node: 8, port: "out"), to: (node: 9, port: "in")),
            (from: (node: 9, port: "out"), to: (node: 10, port: "in")),
        ],
    ),
)
