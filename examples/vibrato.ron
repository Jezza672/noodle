// Vibrato from wiring alone: a 6 Hz sine, scaled up by a gain and added to a
// constant 440 (the Mix's unconnected second input holds that value), drives
// the main oscillator's frequency.
(
    format: 1,
    graph: (
        nodes: {
            1: (type: "noodle.osc.sine", params: {"frequency": 6.0}, position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.util.gain", params: {"gain": 18.0}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.util.mix", params: {"in2": 440.0}, position: (x: 400.0, y: 0.0)),
            4: (type: "noodle.osc.sine", position: (x: 600.0, y: 0.0)),
            5: (type: "noodle.util.gain", params: {"gain": -12.0}, position: (x: 800.0, y: 0.0)),
            6: (type: "noodle.io.output", position: (x: 1000.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "out"), to: (node: 2, port: "in")),
            (from: (node: 2, port: "out"), to: (node: 3, port: "in1")),
            (from: (node: 3, port: "out"), to: (node: 4, port: "frequency")),
            (from: (node: 4, port: "out"), to: (node: 5, port: "in")),
            (from: (node: 5, port: "out"), to: (node: 6, port: "in")),
        ],
    ),
)
