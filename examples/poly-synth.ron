// A polyphonic subtractive synth played from a MIDI clip. The track's MIDI
// goes to Voices (three voices), which gives each note its own pitch, gate and
// velocity lane. Every voice has its own saw, filter and ADSR through a VCA;
// one LFO sweeps all the filters. Voice Mix sums the voices back to one
// signal. The clip is a C major chord, rolled in, then a fourth note while
// all three voices are held, so the first note is stolen.
(
    format: 1,
    graph: (
        nodes: {
            1: (type: "noodle.track.input", position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.poly.voices", config: {"voices": 3}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.osc.saw", position: (x: 400.0, y: -80.0)),
            4: (type: "noodle.filter.svf", params: {"cutoff": 900.0, "resonance": 0.25}, position: (x: 600.0, y: -80.0)),
            5: (type: "noodle.mod.lfo", params: {"rate": 5.0, "depth": 0.06}, position: (x: 400.0, y: -240.0)),
            6: (type: "noodle.mod.adsr", params: {"attack": 0.01, "decay": 0.08, "sustain": 0.6, "release": 0.1}, position: (x: 400.0, y: 100.0)),
            7: (type: "noodle.util.vca", position: (x: 800.0, y: 0.0)),
            8: (type: "noodle.poly.voice_mix", position: (x: 1000.0, y: 0.0)),
            9: (type: "noodle.util.gain", params: {"gain": -14.0}, position: (x: 1200.0, y: 0.0)),
            10: (type: "noodle.io.output", position: (x: 1400.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "midi"), to: (node: 2, port: "in")),
            (from: (node: 2, port: "pitch"), to: (node: 3, port: "frequency")),
            (from: (node: 3, port: "out"), to: (node: 4, port: "in")),
            (from: (node: 5, port: "out"), to: (node: 4, port: "cutoff")),
            (from: (node: 2, port: "gate"), to: (node: 6, port: "gate")),
            (from: (node: 4, port: "low"), to: (node: 7, port: "in")),
            (from: (node: 6, port: "out"), to: (node: 7, port: "level")),
            (from: (node: 7, port: "out"), to: (node: 8, port: "in")),
            (from: (node: 8, port: "out"), to: (node: 9, port: "in")),
            (from: (node: 9, port: "out"), to: (node: 10, port: "in")),
        ],
    ),
    clips: {
        1: (
            node: 1,
            start: 0,
            content: Midi((
                length: 3840,
                notes: [
                    (start: 0, length: 400, key: 48, velocity: 0.9),
                    (start: 40, length: 360, key: 52, velocity: 0.8),
                    (start: 80, length: 400, key: 55, velocity: 0.8),
                    (start: 300, length: 100, key: 60, velocity: 0.9),
                ],
            )),
        ),
    },
)
