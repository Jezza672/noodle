// A 0.6 s loop of kicks and noise hits over a steady tone, recorded at 120
// beats per minute and played in Grain mode. The warp pins the second kick
// (0.16 s into the clip) to beat 0.5 instead of beat 0.32, so the audio before
// it is stretched to about 1.6 times its length and the rest follows at the
// clip's own tempo. Grain keeps the pitch of the kicks and the tone while it
// stretches. The warp is part of the project, not of the graph.
(
    format: 3,
    graph: (
        nodes: {
            1: (type: "noodle.track.input", position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.io.output", position: (x: 250.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "audio"), to: (node: 2, port: "in")),
        ],
    ),
    clips: {
        1: (
            node: 1,
            start: 0,
            content: Audio((
                source: "warp-stretch.wav",
                offset: 0,
                length: 28800,
                gain: 1.0,
                fade_in: 0,
                fade_out: 0,
                warp: Some(1),
            )),
        ),
    },
    warps: {
        1: (
            tempo: (points: [(seconds: 0.0, bpm: 120.0)]),
            markers: [
                (seconds: 0.0, beat: 0.0),
                (seconds: 0.16, beat: 0.5),
            ],
            mode: Grain,
        ),
    },
)
