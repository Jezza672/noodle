// A plucked string at 880 Hz, from primitives. A Key plays A5 while a Button
// is on. A few milliseconds of noise (an ADSR through a VCA) go into a Mix,
// then a Delay, a low-pass filter and a Gain of -0.25 dB, and back to the Mix:
// a feedback loop. The Delay's time is 1 / pitch, less what the filter holds
// the signal back by (a Math node turns that into a fraction of the Delay's
// two seconds of travel), so the loop's period is the note's, about 54
// samples. The loop is much shorter than an audio block; the nodes on it run
// in chunks as short as the delay, with no setting. The `plucked-string`
// template in the library is this with voices.
(
    format: 4,
    graph: (
        nodes: {
            1: (type: "noodle.input.button", params: {"state": 1.0}, position: (x: 0.0, y: 0.0)),
            2: (type: "noodle.event.key", params: {"note": 81.0, "velocity": 0.9}, position: (x: 200.0, y: 0.0)),
            3: (type: "noodle.event.mono", position: (x: 400.0, y: 0.0)),
            4: (type: "noodle.noise.white", position: (x: 600.0, y: -160.0)),
            5: (type: "noodle.mod.adsr", params: {"attack": 0.001, "decay": 0.004, "sustain": 0.0, "release": 0.001}, position: (x: 600.0, y: -40.0)),
            6: (type: "noodle.util.vca", position: (x: 800.0, y: -100.0)),
            7: (type: "noodle.util.mix", position: (x: 1000.0, y: 0.0)),
            8: (type: "noodle.util.delay", params: {"time": 0.0}, position: (x: 1200.0, y: 0.0)),
            9: (type: "noodle.filter.svf", params: {"cutoff": 4000.0, "resonance": 0.0}, position: (x: 1400.0, y: 0.0)),
            10: (type: "noodle.util.gain", params: {"gain": -0.25}, position: (x: 1200.0, y: 160.0)),
            11: (type: "noodle.util.math", config: {"expr": "(1 / max(a, 20) - 0.000024 - 1.4 / (6.2832 * 4000)) / 2"}, position: (x: 600.0, y: 160.0)),
            12: (type: "noodle.util.gain", params: {"gain": -3.0}, position: (x: 1600.0, y: 0.0)),
            13: (type: "noodle.io.output", position: (x: 1800.0, y: 0.0)),
        },
        connections: [
            (from: (node: 1, port: "out"), to: (node: 2, port: "gate")),
            (from: (node: 2, port: "out"), to: (node: 3, port: "in")),
            (from: (node: 3, port: "gate"), to: (node: 5, port: "gate")),
            (from: (node: 4, port: "out"), to: (node: 6, port: "in")),
            (from: (node: 5, port: "out"), to: (node: 6, port: "level")),
            (from: (node: 6, port: "out"), to: (node: 7, port: "in1")),
            (from: (node: 7, port: "out"), to: (node: 8, port: "in")),
            (from: (node: 3, port: "pitch"), to: (node: 11, port: "a")),
            (from: (node: 11, port: "out"), to: (node: 8, port: "time")),
            (from: (node: 8, port: "out"), to: (node: 9, port: "in")),
            (from: (node: 9, port: "low"), to: (node: 10, port: "in")),
            (from: (node: 10, port: "out"), to: (node: 7, port: "in2")),
            (from: (node: 9, port: "low"), to: (node: 12, port: "in")),
            (from: (node: 12, port: "out"), to: (node: 13, port: "in")),
        ],
    ),
)
